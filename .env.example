# 복사해서 .env 로 만든 뒤 값을 채운다. 실제 비밀값은 커밋하지 않는다.
NODE_ENV=development
PORT=3000
TZ=Asia/Seoul

# MySQL 8 (docker compose 기본값과 일치)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ras
DB_PASSWORD=ras_dev_password
DB_NAME=ras_point
# db:reset 등 스키마 재생성에만 쓰는 루트 계정(개발 전용)
DB_ROOT_PASSWORD=root_dev_password

# 세션 서명 키(32자 이상 임의 문자열)
SESSION_SECRET=change-me-to-a-long-random-string-32chars

# 업로드 저장 경로(리사이즈본만 저장)
UPLOAD_DIR=server/uploads

# 개발 중 Vite dev 서버 주소(CORS 허용)
CLIENT_ORIGIN=http://localhost:5173
